# ============================================================
#  Cle du service d'IA — a definir dans Vercel, PAS dans ce fichier
#  Vercel > votre projet > Settings > Environment Variables
#  Une seule suffit. Les trois premieres sont gratuites.
# ============================================================

# Groq — gratuit — https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — gratuit — https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Mistral — offre gratuite — https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=

# Anthropic — payant — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# OpenAI — payant — https://platform.openai.com/api-keys
# OPENAI_API_KEY=
